{
  "schema_version": 1,
  "initialization": {
    "exclude": [
      ".github/workflows",
      ".github/skills",
      ".github/instructions",
      "AGENTS.md",
      ".config.md",
      "distribution",
      ".github/onesquad",
      "site",
      "apps/pages/docs",
      "docs/architecture/adr",
      "docs/project"
    ]
  },
  "files": [
    {
      "source": ".github/onesquad/sources/update-review.md",
      "destination": "docs/run/onesquad/update-review.md",
      "policy": "merge"
    },
    {
      "source": ".github/onesquad/sources/contributor-guide.md",
      "destination": "AGENTS.md",
      "policy": "merge"
    },
    {
      "source": ".github/onesquad/sources/configuration-example.md",
      "destination": ".config.example.md",
      "policy": "seed"
    },
    {
      "source": ".github/onesquad/sources/check-version.py",
      "destination": "scripts/onesquad-check-version.py",
      "policy": "managed"
    }
  ]
}
